{% extends 'base.html.twig' %}

{% block body %}

    <div class="container my-5">
        <h1>
            Espace membre
        </h1>

        <div class="row g-0 my-5">
            {% include 'account/_menu.html.twig' %}

            <div class="col-md-8">
                <h4 class="card-title m-3">
                    Ma liste de souhaits
                    <span class="text-success">
                        (
                        {{ app.user.wishlists|length }}
                        articles)
                    </span>
                </h4>

                <div class="card-body p-3">

                    {% if app.user.wishlists|length > 0 %}

                        <!-- FLEX MODE -->
                        <div class="d-flex flex-wrap gap-4">
                            {% for product in app.user.wishlists %}
                                <div class="card col-md-3 border-0 shadow-sm rounded-4 overflow-hidden">

                                    <img src="/uploads/products/{{ product.illustration }}" class="card-img-top img-fluid" alt="{{ product.name }}">

                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title fw-bold text-dark">
                                                {{ product.name }}
                                            </h5>

                                            <p class="card-text text-accent fw-bold">
                                                {{ product._getPriceWt|price }}
                                            </p>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <!-- Bouton Ajouter au panier -->
                                                <a href="{{ path('app_product', {'slug': product.slug}) }}" class="btn btn-dark btn-sm mt-auto w-100 d-flex align-items-center justify-content-center gap-2 py-2 fs-7 rounded-3">
                                                    <i data-feather="shopping-cart"></i>
                                                    Voir... 
                                                </a>
                                                <!-- Bouton Ajouter à la liste de souhaits -->
                                                <a href="{{ path('app_account_wishlist_remove', {id : product.id}) }}" class="btn btn-outline-danger btn-sm ms-1 d-flex align-items-center justify-content-center py-2 rounded-3">
                                                        <i data-feather="trash" class=""></i> 
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                        {% else %}
                            <p class="text-muted">
                                Vous n'avez pas encore ajouté de produit à votre liste de souhaits.
                                <a href="{{ path('app_home') }}">
                                    Découvrez nos produits
                                </a>
                                et ajoutez-les à votre liste en cliquant sur l'icône en forme de cœur.
                            </p>
                        {% endif %}

                    </div>
                </div>
            </div>
        </div>

    {% endblock %}
    