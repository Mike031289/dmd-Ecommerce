{% extends 'base.html.twig' %}
{% block body %}
    <div class="container my-5">
        <h1>
            Espace membre
        </h1>
        <div class="row g-0 my-5">
            {% include 'account/_menu.html.twig' %}
            <div class="col-md-8">
                <h5 class="card-title m-3">
                    Mes dernières commandes
                </h5>
                {% if orders|length == 0 %}
                    <div class="alert alert-info m-3" role="alert">
                        <p>
                            Vous n'avez pas encore passé de commande.
                        </p>
                        <a href="{{ path('app_home') }}" class="btn btn-dark">
                            Retour à la boutique
                        </a>
                    </div>
                {% else %}
                    <div class="card-body text-dark">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">
                                        N°
                                    </th>
                                    <th scope="col">
                                        Date
                                    </th>
                                    <th scope="col">
                                        Statut
                                    </th>
                                    <th scope="col">
                                        Total T.T.C
                                    </th>
                                    <th scope="col">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders %}
                                    <tr class="">
                                        <th scope="row">
                                            {{ order.id }}
                                        </th>
                                        <td>
                                            {{  order.createdAt|date('d/m/Y')  }}
                                        </td>
                                        <td>
                                            {{ include('admin/state.html.twig', {field: { 'value' : order.state }}) }}
                                        </td>
                                        <td>
                                            {{ (order.totalWt|price)}}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_account_order', {'id': order.id}) }}" class="btn btn-sm btn-secondary">
                                            Voir ma commande...
                                            </a>
                                        </td>
                                    </tr>   
                                {% endfor %}
                                
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endblock %}
    