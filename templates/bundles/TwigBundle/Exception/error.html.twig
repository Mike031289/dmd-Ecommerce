{# templates/bundles/TwigBundle/Exception/error.html.twig #}
{% extends 'base.html.twig' %}
{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-6 p-5">
                <div class="p-4 shadow-sm rounded bg-white text-center">
                    <img src="{{ asset('assets/logo/dmd_logo.png') }}" alt="Logo DMD" class="error-logo img-fluid mb-3">
                        <h1 class="h3 mb-3 error-code">
                            Page introuvable
                        </h1>
                        <h6 class="mb-3  error-title">
                            Oups ! Une erreur s’est produite.
                        </h6>
                        <p class="text-muted mb-4 error-message">
                            La page demandée est introuvable.
                            Vérifiez l’URL pour vous assurer qu’il n’y a pas de faute d’orthographe.
                        </p>
                        <a href="{{ path('app_home') }}" class="btn btn-success w-100">
                            Retour à l’accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
    