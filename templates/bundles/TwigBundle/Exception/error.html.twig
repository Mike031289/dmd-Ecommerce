{# templates/bundles/TwigBundle/Exception/error404.html.twig #}
<!doctype html>
<html lang="fr" data-bs-theme="auto">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            Dmd-Shop - 100% Made in France
        </title>
        <meta name="description" content="La boutique spécialisée dans la fabrication Made In France">
        <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
        <link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet">
        <!-- Custom styles for this template -->
        <link href="{{ asset('assets/css/carousel.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/custom.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/form.css') }}" rel="stylesheet">
        <link href="{{ asset('assets/css/error-page.css') }}" rel="stylesheet">
        <script src="https://unpkg.com/feather-icons"></script>
    </head>
</html>
{% block body %}
    <div class="error-container">
        <!-- Replace src with your own image or illustration -->
        <img src="{{ asset('assets/logo/dmd_logo.png') }}" alt="Error illustration">
        <!-- Change code as needed (404, 500, etc.) -->
        <div class="error-code">
            Page introuvable
        </div>
        <div class="error-title">
            Oups ! Une erreur s'est produite.
        </div>
        <div class="error-message">
            La page demandée est introuvable. Vérifiez l'URL
            pour vous assurer qu'il n'y a pas de faute d'orthographe.
        </div>
        <a href="/" class="error-button">
            Retour à l'accueil
        </a>
    </div>
{% endblock %}
